# Public browser configuration only. Copy to .env.staging after the dedicated
# GridVision Staging Supabase project exists. Never add service-role, database,
# Vault, or Firebase private credentials to a VITE_ variable.
VITE_SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=STAGING_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Optional public Cloudflare Turnstile site key. Never add the secret key here.
VITE_TURNSTILE_SITE_KEY=TURNSTILE_PUBLIC_SITE_KEY
